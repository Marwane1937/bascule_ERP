{
  "watch": ["src"],
  "ext": "js,json",
  "ignore": ["src/**/*.spec.js", "node_modules", "src/public/**", "src/public/devis/**"],
  "delay": 300,
  "verbose": false,
  "legacyWatch": false,
  "env": {
    "NODE_ENV": "development",
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },
  "exec": "node -r dotenv/config src/server.js"
}

